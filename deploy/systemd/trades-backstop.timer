# Every 15 minutes through the session, and once more at 3:56pm New York time (after the
# market-on-close orders, before the closing auction). The command does nothing while the market
# is closed or the runner's heartbeat is fresh.
[Unit]
Description=Trades: backstop check while the market is open

[Timer]
OnCalendar=Mon..Fri 09..15:00/15 America/New_York
OnCalendar=Mon..Fri 15:56 America/New_York

[Install]
WantedBy=timers.target
