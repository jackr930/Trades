# Names only. Never put real values in this file or anywhere in the repository.
#
# Copy it to a file OUTSIDE the repository, e.g. /etc/trades/paper.env (chmod 600), and point
# the trader at it (deploy/docker-compose.yml does). Keep paper and live keys in separate files,
# and keep live keys only on the trading machine, never on a machine that runs Claude Code.

# Alpaca: market data, and the PAPER trading account (generate the key from the paper account)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Massive (formerly Polygon.io): historical intraday bars for research
MASSIVE_API_KEY=

# Alerts from the paper trader (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web app behind a login when it is reachable from other machines (see README: Put it online)
TRADES_PASSWORD=
TRADES_SECRET_KEY=
